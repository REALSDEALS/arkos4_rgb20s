# This repo is a byte-exact overlay of a Linux root filesystem. Never let git
# convert line endings by default: on a Windows checkout with core.autocrlf=true
# extensionless scripts (perfmax, switch-kernel, rk817-calibrationd, ...),
# systemd units and modules.* index files were written with CRLF, which breaks
# them on the device if the image is built from that checkout.
# The rules below still force LF for the listed text types.
* -text

*.sh text eol=lf

*.go text eol=lf

*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.txt text eol=lf

*.dts text eol=lf
*.dtsi text eol=lf
*.mk text eol=lf

Makefile text eol=lf
*.mk text eol=lf

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf

*.bmp binary
*.png binary
*.jpg binary
*.gif binary
*.dtb binary
*.bin binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
